{
  "manifest_version": 3,
  "name": "YouTube Feed Summariser",
  "version": "0.4.7",
  "description": "Adds a Summarise button to YouTube video cards and shows an AI-written summary inline, so you can tell what a video covers before committing 20 minutes to it.",
  "key": "",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Feed Summariser"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://*.up.railway.app/*"
  ],
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content/surfaces.js",
        "content/button.js",
        "content/panel.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
