{
  "manifest_version": 3,
  "name": "YouTube Feed Summariser (dev)",
  "version": "0.2.0",
  "description": "Adds a Summarise button to YouTube video cards and shows an AI-written summary inline, so you can tell what a video covers before committing 20 minutes to it.",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8787/*"
  ],
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": [
        "content/surfaces.js",
        "content/button.js",
        "content/panel.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
